# ==============================================================================
# Root Environment Variables Template
# AI Software Failure Investigator - Phase 1 Foundation
# ==============================================================================

# Supabase Configuration
# Obtain from: https://supabase.com/dashboard/project/<your-project-ref>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional service role key (reserved for future privileged backend operations; do NOT expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Settings (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api
