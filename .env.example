# ==============================================================================
# AI Software Failure Investigator — Environment Configuration Template
# Copy this file to .env and populate with production / development secrets.
# Do NOT commit .env with real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production | test)
ENVIRONMENT=production

# Server Host and Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# API Documentation Control (true enables /docs & /redoc; default false in production)
ENABLE_DOCS=false

# Supabase PostgreSQL Configuration
# SUPABASE_URL: Your Supabase project URL (e.g. https://xyz.supabase.co)
# SUPABASE_ANON_KEY: Client-side publishable key
# SUPABASE_SECRET_KEY: Dedicated server-side secret key (recommended by Supabase, NEVER expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY: Legacy server-side key (deprecated fallback, migrate to SUPABASE_SECRET_KEY)
# SUPABASE_JWT_SECRET: Optional Supabase JWT secret for local cryptographic JWT verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS Configuration (comma-separated list of allowed origins)
# In production, specify exact frontend domains (wildcard '*' is forbidden with credentials)
CORS_ORIGINS=https://your-frontend-app.vercel.app,https://yourdomain.com

# Rate Limiting & Resource Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_ANALYZE_PER_MINUTE=6
MAX_REPO_SIZE_MB=100
CLONE_TIMEOUT_SECONDS=60
ANALYSIS_TIMEOUT_SECONDS=60
MAX_EVIDENCE_SIZE_TOTAL_PER_CASE_BYTES=2097152

# Proxy Configuration (number of trusted reverse proxies in front of FastAPI)
TRUSTED_PROXY_COUNT=0

# Ownership Bootstrap (UUID assigned to pre-Phase 5 unowned investigation records)
BOOTSTRAP_OWNER_USER_ID=00000000-0000-0000-0000-000000000001
