# ==============================================================================
# AI Software Failure Investigator — Backend Configuration Template
# ==============================================================================

ENVIRONMENT=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENABLE_DOCS=false

# Supabase Server Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy server-side key (deprecated fallback, migrate to SUPABASE_SECRET_KEY):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS & Security
CORS_ORIGINS=https://your-frontend-app.vercel.app
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_ANALYZE_PER_MINUTE=6

# Resource Safety Limits
MAX_REPO_SIZE_MB=100
CLONE_TIMEOUT_SECONDS=60
ANALYSIS_TIMEOUT_SECONDS=60
MAX_EVIDENCE_SIZE_TOTAL_PER_CASE_BYTES=2097152

TRUSTED_PROXY_COUNT=0
BOOTSTRAP_OWNER_USER_ID=00000000-0000-0000-0000-000000000001
